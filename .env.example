# CloudCLI UI Environment Configuration
#
# Copy the values you need into `.env`.

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
SERVER_PORT=3001

# Frontend dev server port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Optional: lock the instance so new users cannot self-register
# AUTH_DISABLE_REGISTRATION=true

# Optional: expose platform mode flags to the frontend
# VITE_IS_PLATFORM=false

# Optional: custom Claude CLI binary path
# CLAUDE_CLI_PATH=claude

# Optional: prefer globally installed CLIs over local node_modules/.bin wrappers
# CLAUDE_CODE_UI_PREFER_GLOBAL_AGENT_CLI=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Custom auth database location
# DATABASE_PATH=/path/to/auth.db

# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# E2B CLOUD SANDBOX CONFIGURATION
# =============================================================================

# Set to `e2b` to run agents in E2B cloud sandboxes instead of locally
# RUNTIME_MODE=e2b

# E2B API key (required for cloud runtime)
# E2B_API_KEY=

# Optional: custom E2B sandbox template reference
# E2B_TEMPLATE=

# Optional: template name/tag helpers used by the local build scripts
# E2B_TEMPLATE_NAME=claudecodeui-cloud-agent
# E2B_TEMPLATE_TAGS=latest

# Optional: override the host/IP that E2B sandboxes should call back to
# E2B_SANDBOX_CONNECT_HOST=
# E2B_PUBLIC_HOST=

# API keys that can be mirrored into the E2B sandbox
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# CURSOR_API_KEY=
# GITHUB_TOKEN=

# Optional: proxy for auth sync / OAuth calls from the backend
# AUTH_CENTER_PROXY_URL=

# =============================================================================
# TERMINALD CONFIGURATION
# =============================================================================

# Durable terminal sidecar used by local/E2B shells
# TERMINALD_HOST=0.0.0.0
# TERMINALD_PORT=3112
# TERMINALD_DB_PATH=/path/to/terminald.sqlite
# TERMINALD_TMUX_BIN=tmux
# TERMINALD_LOCAL_SHELL=/bin/bash
# TERMINALD_E2B_SHELL=bash

# =============================================================================
# GITHUB OAUTH CONFIGURATION
# =============================================================================

# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set the callback URL to: http://your-host:3001/api/github/oauth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3001/api/github/oauth/callback
